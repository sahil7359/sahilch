# Copy to .env.local and fill. .env.local is gitignored.
# Feature flags — a flag OFF means the feature does not render at all.
NEXT_PUBLIC_FEATURE_CHAT=false        # needs GROQ + EMBEDDING + SUPABASE
NEXT_PUBLIC_FEATURE_TICKETS=false     # needs SUPABASE + RESEND + TURNSTILE

# Server-only
IP_HASH_SALT=

# Chat (server)
GROQ_API_KEY=
EMBEDDING_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email (server)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
